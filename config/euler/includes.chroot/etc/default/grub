# Euler GRUB — Mac-style quiet + tuning SSD/8GB
GRUB_DEFAULT=0
GRUB_TIMEOUT=2
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="Euler"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash mitigations=auto,nosmt preempt=voluntary transparent_hugepage=madvise init_on_alloc=0 init_on_free=0 zswap.enabled=0 nowatchdog nmi_watchdog=0 nvme_core.default_ps_max_latency_us=0"
GRUB_CMDLINE_LINUX=""
GRUB_TERMINAL_OUTPUT=gfxterm
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_OS_PROBER=false
GRUB_BACKGROUND=/usr/share/plymouth/themes/euler/background.png
